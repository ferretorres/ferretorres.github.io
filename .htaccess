# Keep extensionless legal URLs and existing files available.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host "^(www\.)?ferretorres\.eu(:[0-9]+)?$" ferre_public_site
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|avif|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Cache-Control "public, max-age=3600, must-revalidate" env=ferre_public_site
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
